   "lines": [
    "import requests",
    "import threading",
    "import time",
    "",
    "# Shared list for discovered subdomains",
    "discovered_subdomains = []",
    "lock = threading.Lock()",
    "",
    "# Function to check each subdomain with HTTP request",
    "def check_subdomain(subdomain):",
    "    url = f\"http://{subdomain}\"",
    "    try:",
    "        response = requests.get(url, timeout=5)",
    "        if response.status_code == 200:",
    "            with lock:",
    "                discovered_subdomains.append(url)",
    "                print(f\"[+] Found: {url}\")",
    "    except requests.RequestException:",
    "        pass  # Ignore any failed requests",
    "",
    "",
    "# Fetch subdomains from crt.sh",
    "def fetch_from_crtsh(domain, limit=15):",
    "    print(f\"[*] Trying crt.sh for {domain} ...\")",
    "    url = f\"https://crt.sh/?q=%25.{domain}&output=json\"",
    "    try:",
    "        response = requests.get(url, timeout=15)",
    "        data = response.json()",
    "        subdomains = set()",
    "        for entry in data:",
    "            for sub in entry[\"name_value\"].split(\"\\n\"):",
    "                clean_sub = sub.strip().lower().lstrip(\"*.\")  # remove wildcards",
    "                if clean_sub.endswith(domain):",
    "                    subdomains.add(clean_sub)",
    "        return list(subdomains)[:limit]",
    "    except Exception as e:",
    "        print(f\"[!] crt.sh failed: {e}\")",
    "        return []",
    "",
    "",
    "# Fetch subdomains from hackertarget.com",
    "def fetch_from_hackertarget(domain, limit=15):",
    "    print(f\"[*] Trying hackertarget.com for {domain} ...\")",
    "    url = f\"https://api.hackertarget.com/hostsearch/?q={domain}\"",
    "    try:",
    "        response = requests.get(url, timeout=10)",
    "        lines = response.text.splitlines()",
    "        subdomains = [line.split(\",\")[0] for line in lines if domain in line]",
    "        return list(set(subdomains))[:limit]",
    "    except Exception as e:",
    "        print(f\"[!] Hackertarget failed: {e}\")",
    "        return []",
    "",
    "",
    "# Master fetch function: try crt.sh first, fallback to hackertarget",
    "def fetch_subdomains(domain, limit=15):",
    "    subdomains = fetch_from_crtsh(domain, limit)",
    "    if not subdomains:",
    "        subdomains = fetch_from_hackertarget(domain, limit)",
    "    return subdomains",
    "",
    "",
    "def main():",
    "    # Ask user for domain",
    "    domain = input(\"Enter domain (e.g., google.com): \").strip()",
    "",
    "    # Fetch subdomains",
    "    subdomains = fetch_subdomains(domain, limit=15)",
    "    if not subdomains:",
    "        print(\"[!] No subdomains found, exiting...\")",
    "        return",
    "",
    "    print(f\"[*] Checking {len(subdomains)} subdomains...\")",
    "    threads = []",
    "",
    "    for subdomain in subdomains:",
    "        t = threading.Thread(target=check_subdomain, args=(subdomain,))",
    "        t.start()",
    "        threads.append(t)",
    ""
   ]
